[submodule "zsh/plugins/zsh-syntax-highlighting"]
	path = ansible/roles/dotfiles/files/home/zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
	branch = master
[submodule "zsh/plugins/zsh-autosuggestions"]
	path = ansible/roles/dotfiles/files/home/zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
	branch = master
[submodule "zsh/plugins/zsh-completions"]
	path = ansible/roles/dotfiles/files/home/zsh/plugins/zsh-completions
	url = https://github.com/zsh-users/zsh-completions.git
	branch = master
