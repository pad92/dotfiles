{
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "on-click": "~/.config/waybar/modules/cycle-default-sink",
    "on-click-right": "pavucontrol"
  },
  "custom/headsetcontrol": {
    "format": "{}",
    "exec": "~/.config/waybar/modules/headsetcontrol",
    "tooltip": false,
    "interval": 3600
  }
}
