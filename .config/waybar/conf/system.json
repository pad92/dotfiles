{
  "clock": {
    "locale": "fr_FR.UTF-8",
    "format": "{:L%a %d %b %Y  %H:%M}",
    "tooltip-format": "{calendar}"
  },
  "cpu": {
    "format": "{usage}% "
  },
  "memory": {
    "format": "{}% "
  },
  "custom/lact-profile": {
    "exec": "$HOME/.config/waybar/modules/lact-profile status",
    "on-click": "$HOME/.config/waybar/modules/lact-profile cycle",
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  "tray": {
    "spacing": 5
  }
}
