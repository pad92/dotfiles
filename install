#!/usr/bin/env bash

# Modernized dotfiles installation script
# This script sets up the environment using dotbot and handles vim plugin installation.

set -euo pipefail

# --- Configuration ---
CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
# Get the absolute path of the script directory
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ACTION="install"
PACKAGE_STATE_FILE="${XDG_STATE_HOME:-${HOME}/.local/state}/dotfiles/arch-packages.json"
DOTBOT_ARGS=()
SHOW_HELP=false
PACKAGE_STATE_LOADED=false
PREVIOUS_SELECTED_GROUPS=()
PREVIOUS_OWNED_PACKAGES=()
DEFAULT_PACKAGE_GROUPS=(01_base 03_gtk 11_hyprland)
declare -A PACKAGE_GROUP_DEFAULTS=()

# --- Colors for output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# --- Helper Functions ---

show_help() {
    cat <<'EOF'
Usage: ./install [OPTIONS] [-- DOTBOT_ARGS...]

Install the dotfiles and optionally manage selectable Arch Linux package groups.

Options:
  --package-plan         Preview package installs and managed removals without
                         making changes or requesting sudo access.
  --reconcile-packages   Install selected packages and offer to remove packages
                         previously installed by this installer but no longer
                         selected. Removal requires explicit confirmation.
  -h, --help             Show this help and exit.

Unrecognized arguments are forwarded to Dotbot. Use -- to stop parsing installer
options and forward every remaining argument to Dotbot.
EOF
}

parse_install_args() {
    while (( $# > 0 )); do
        case "$1" in
            --package-plan)
                if [[ "$PACKAGE_ACTION" != "install" ]]; then
                    log_error "Only one package action may be selected."
                    return 1
                fi
                PACKAGE_ACTION="plan"
                ;;
            --reconcile-packages)
                if [[ "$PACKAGE_ACTION" != "install" ]]; then
                    log_error "Only one package action may be selected."
                    return 1
                fi
                PACKAGE_ACTION="reconcile"
                ;;
            -h|--help)
                SHOW_HELP=true
                ;;
            --)
                shift
                DOTBOT_ARGS+=("$@")
                break
                ;;
            *)
                DOTBOT_ARGS+=("$1")
                ;;
        esac
        shift
    done
}

backup_existing_files() {
    log_info "Backing up existing regular files that should be symlinks..."

    # Extract target paths from the config file
    # We look for lines containing '~/' and a ':' (literal tilde search, not expansion)
    # shellcheck disable=SC2088
    grep '~/' "${BASEDIR}/${CONFIG}" | grep ':' | sed 's/ *:.*//' | sed 's/^ *//' \
    | while IFS= read -r target; do
        local full_path="${target/#\~/$HOME}"

        if [[ -f "$full_path" && ! -L "$full_path" ]]; then
            local backup_path="${full_path}.bak"
            log_warn "Backing up existing regular file: $full_path -> $backup_path"
            mv -f "$full_path" "$backup_path"
        fi
    done
    log_success "Backup completed."
}

check_dependencies() {
    log_info "Checking dependencies..."
    local deps=("git" "python3")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            log_error "Required dependency '$dep' is not installed. Please install it and try again."
            exit 1
        fi
    done
    log_success "All dependencies found."
}

setup_dotbot() {
    log_info "Updating dotbot submodule..."

    # Init first (required on fresh clones), then sync nested submodules
    git -C "${BASEDIR}" submodule update --init --recursive "${DOTBOT_DIR}"
    git -C "${BASEDIR}/${DOTBOT_DIR}" submodule sync --quiet --recursive

    log_success "Dotbot submodule updated."
}

run_dotbot() {
    log_info "Running dotbot to link configuration files..."

    local dotbot_path="${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}"

    if [[ ! -x "$dotbot_path" ]]; then
        log_error "Dotbot binary not found or not executable at $dotbot_path"
        exit 1
    fi

    # Execute dotbot with provided arguments
    "${dotbot_path}" -d "${BASEDIR}" -c "${BASEDIR}/${CONFIG}" "${@}"

    log_success "Dotbot execution completed."
}

install_vim_plugins() {
    if ! command -v vim &> /dev/null; then
        log_warn "Vim not found, skipping plugin installation."
        return 0
    fi
    if [[ ! -t 0 ]]; then
        log_warn "No TTY available, skipping Vim plugin installation."
        return 0
    fi
    log_info "Installing and updating Vim plugins..."
    vim +PluginInstall +PluginUpdate +qall
    log_success "Vim plugins updated."
}

# --- Arch Linux / CachyOS Packages Installation ---

is_arch_or_cachyos() {
    if [[ ! -f /etc/os-release ]]; then
        return 1
    fi
    local ID="" ID_LIKE=""
    . /etc/os-release
    [[ "$ID" == "arch" || "$ID" == "cachyos" || "$ID_LIKE" =~ arch ]]
}

is_graphics_package_group() {
    case "$1" in
        07_intel_legacy|08_amd|08_intel_modern|09_nvidia_legacy|09_nvidia_modern)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

apply_standard_package_defaults() {
    local group
    for group in "${DEFAULT_PACKAGE_GROUPS[@]}"; do
        PACKAGE_GROUP_DEFAULTS["$group"]=1
    done
}

detect_graphics_package_groups_from_pci() {
    local pci_devices=$1
    local line normalized group
    local -A detected_groups=()

    while IFS= read -r line; do
        [[ "$line" =~ \[(0300|0302)\] ]] || continue
        normalized=${line,,}
        group=""

        case "$normalized" in
            *"[1002:"*)
                group="08_amd"
                ;;
            *"[8086:"*)
                case "$normalized" in
                    *gma*|*ironlake*|*sandy\ bridge*|*ivy\ bridge*|*haswell*|\
                    *2nd\ gen*core*|*3rd\ gen*core*|*4th\ gen*core*|\
                    *"hd graphics 2000"*|*"hd graphics 2500"*|*"hd graphics 3000"*|\
                    *"hd graphics 4000"*|*"hd graphics 4200"*|*"hd graphics 4400"*|\
                    *"hd graphics 4600"*|*"hd graphics 5000"*|*"hd graphics 5100"*)
                        group="07_intel_legacy"
                        ;;
                    *)
                        # intel-media-driver supports Broadwell and newer GPUs.
                        group="08_intel_modern"
                        ;;
                esac
                ;;
            *"[10de:"*)
                case "$normalized" in
                    *maxwell*|*pascal*|*volta*|*"[gm"[0-9]*|*"[gp"[0-9]*|*"[gv"[0-9]*|\
                    *"geforce gtx 745"*|*"geforce gtx 750"*|*"geforce gtx 8"[0-9][0-9]*|\
                    *"geforce gtx 9"[0-9][0-9]*|*"geforce gtx 10"[0-9][0-9]*|\
                    *"quadro m"[0-9]*|*"quadro p"[0-9]*|*"tesla m"[0-9]*|\
                    *"tesla p"[0-9]*|*"tesla v"[0-9]*|*"titan v"*|*"titan x"*)
                        group="09_nvidia_legacy"
                        ;;
                    *)
                        # Current NVIDIA GPUs (Turing and newer) use the open modules.
                        group="09_nvidia_modern"
                        ;;
                esac
                ;;
        esac

        if [[ -n "$group" ]]; then
            detected_groups["$group"]=1
        fi
    done <<< "$pci_devices"

    if (( ${#detected_groups[@]} == 0 )); then
        return 1
    fi
    printf '%s\n' "${!detected_groups[@]}" | sort
}

detect_graphics_package_groups() {
    local pci_devices=""

    if command -v lspci &> /dev/null; then
        pci_devices=$(lspci -Dnn 2>/dev/null || true)
    else
        local device_path class vendor device
        for device_path in /sys/bus/pci/devices/*; do
            [[ -r "$device_path/class" && -r "$device_path/vendor" \
                && -r "$device_path/device" ]] || continue
            class=$(<"$device_path/class")
            case "$class" in
                0x0300*|0x0302*) ;;
                *) continue ;;
            esac
            vendor=$(<"$device_path/vendor")
            device=$(<"$device_path/device")
            pci_devices+=" [${class:2:4}]: [${vendor:2}:${device:2}]"$'\n'
        done
    fi

    detect_graphics_package_groups_from_pci "$pci_devices"
}

apply_detected_graphics_defaults() {
    local detected_output
    if ! detected_output=$(detect_graphics_package_groups); then
        log_warn "No supported PCI graphics controller was detected; GPU groups were not changed."
        return 0
    fi

    local group
    for group in "${!PACKAGE_GROUP_DEFAULTS[@]}"; do
        if is_graphics_package_group "$group"; then
            unset 'PACKAGE_GROUP_DEFAULTS[$group]'
        fi
    done
    while IFS= read -r group; do
        PACKAGE_GROUP_DEFAULTS["$group"]=1
    done <<< "$detected_output"

    log_info "Automatically selected graphics groups: ${detected_output//$'\n'/, }."
}

# --- Interactive Menu Helpers ---
ESC=$(printf '\033')
cursor_up() { printf "\033[%dA" "$1" >&2; }
hide_cursor() { printf "\033[?25l" >&2; }
show_cursor() { printf "\033[?25h" >&2; }

read_key() {
    local key
    IFS= read -r -s -n 1 key < /dev/tty
    if [[ "$key" == "$ESC" ]]; then
        IFS= read -r -s -n 2 -t 0.1 key < /dev/tty || true
        if [[ -z "$key" ]]; then
            echo "ESCAPE"
        elif [[ "$key" == "[A" ]]; then
            echo "UP"
        elif [[ "$key" == "[B" ]]; then
            echo "DOWN"
        fi
    elif [[ "$key" == " " ]]; then
        echo "SPACE"
    elif [[ "$key" == "" || "$key" == $'\r' || "$key" == $'\n' ]]; then
        echo "ENTER"
    fi
}

draw_menu() {
    local active_idx=$1
    for i in "${!options[@]}"; do
        local prefix="  "
        if (( i == active_idx )); then
            prefix="${BLUE}➔${NC} "
        fi

        local check="[ ]"
        if [[ "${selected[i]}" == "1" ]]; then
            check="[${GREEN}*${NC}]"
        fi

        if (( i == active_idx )); then
            printf "%b%b %b\n" "$prefix" "$check" "${BLUE}${options[i]}${NC}" >&2
        else
            printf "%b%b %b\n" "$prefix" "$check" "${options[i]}" >&2
        fi
    done
}

show_multi_select() {
    local -a options=("${@}")
    local -a selected=()
    for i in "${!options[@]}"; do
        if [[ -n "${PACKAGE_GROUP_DEFAULTS[${options[i]}]+x}" ]]; then
            selected[i]=1
        else
            selected[i]=0
        fi
    done

    local active=0
    local num_options=${#options[@]}

    hide_cursor
    draw_menu "$active"

    while true; do
        local key
        key=$(read_key)

        case "$key" in
            UP)
                if (( active > 0 )); then
                    active=$((active - 1))
                else
                    active=$((num_options - 1))
                fi
                ;;
            DOWN)
                if (( active < num_options - 1 )); then
                    active=$((active + 1))
                else
                    active=0
                fi
                ;;
            SPACE)
                if [[ "${selected[active]}" == "1" ]]; then
                    selected[active]=0
                else
                    selected[active]=1
                fi
                ;;
            ENTER)
                break
                ;;
            ESCAPE)
                for i in "${!selected[@]}"; do
                    selected[i]=0
                done
                break
                ;;
        esac

        cursor_up "$num_options"
        draw_menu "$active"
    done

    show_cursor

    local results=()
    for i in "${!options[@]}"; do
        if [[ "${selected[i]}" == "1" ]]; then
            results+=("$i")
        fi
    done
    if (( ${#results[@]} > 0 )); then
        echo "${results[@]}"
    fi
}

ensure_aur_helper() {
    if command -v paru &> /dev/null; then
        AUR_HELPER="paru"
        return 0
    fi
    if command -v yay &> /dev/null; then
        AUR_HELPER="yay"
        return 0
    fi

    log_info "No AUR helper (paru or yay) found."
    local choice
    read -rp "Would you like to install yay? [Y/n] " choice < /dev/tty
    if [[ "$choice" =~ ^[Nn]$ ]]; then
        log_warn "AUR helper installation declined; AUR packages will be skipped."
        return 2
    fi

    if (( EUID == 0 )); then
        log_error "yay must be built as a regular user, not root."
        return 1
    fi

    log_info "Installing yay build dependencies from the official repositories..."
    if ! sudo pacman -Syu --needed -- base-devel git; then
        log_error "Failed to install yay build dependencies."
        return 1
    fi
    if ! command -v makepkg &> /dev/null; then
        log_error "makepkg is unavailable after installing base-devel."
        return 1
    fi

    local tmpdir
    if ! tmpdir=$(mktemp -d); then
        log_error "Failed to create a temporary build directory."
        return 1
    fi
    log_info "Building and installing yay..."
    if ! (
        trap 'rm -rf "$tmpdir"' EXIT
        git clone https://aur.archlinux.org/yay-bin.git "$tmpdir/yay-bin" &> /dev/null
        cd "$tmpdir/yay-bin"
        makepkg -si --noconfirm
    ); then
        log_error "Failed to build or install yay."
        rm -rf "$tmpdir"
        return 1
    fi
    rm -rf "$tmpdir"

    if ! command -v yay &> /dev/null; then
        log_error "yay is still unavailable after installation."
        return 1
    fi
    AUR_HELPER="yay"
    log_success "yay installed successfully!"
}

load_package_state() {
    PACKAGE_STATE_LOADED=false
    PREVIOUS_SELECTED_GROUPS=()
    PREVIOUS_OWNED_PACKAGES=()

    if [[ ! -f "$PACKAGE_STATE_FILE" ]]; then
        return 0
    fi

    local state_output
    if ! state_output=$(python3 - "$PACKAGE_STATE_FILE" <<'PY'
import json
import re
import sys

path = sys.argv[1]
name_pattern = re.compile(r"^[a-zA-Z0-9@._+-]+$")
with open(path, encoding="utf-8") as state_file:
    state = json.load(state_file)

if state.get("version") != 1:
    raise ValueError("unsupported package-state version")

for key, record_type in (("selected_groups", "group"), ("owned_packages", "package")):
    values = state.get(key)
    if not isinstance(values, list) or not all(
        isinstance(value, str) and name_pattern.fullmatch(value) for value in values
    ):
        raise ValueError(f"invalid {key}")
    for value in values:
        print(f"{record_type}\t{value}")
PY
    ); then
        log_warn "Package state is invalid; automatic removal is disabled."
        return 0
    fi

    local record_type value
    while IFS=$'\t' read -r record_type value; do
        case "$record_type" in
            group) PREVIOUS_SELECTED_GROUPS+=("$value") ;;
            package) PREVIOUS_OWNED_PACKAGES+=("$value") ;;
        esac
    done <<< "$state_output"
    PACKAGE_STATE_LOADED=true
}

write_package_state() {
    local groups_name=$1
    local packages_name=$2
    local -n groups_ref="$groups_name"
    local -n packages_ref="$packages_name"

    python3 - "$PACKAGE_STATE_FILE" "${#groups_ref[@]}" \
        "${groups_ref[@]}" "${packages_ref[@]}" <<'PY'
import json
import os
import sys
import tempfile

path = sys.argv[1]
group_count = int(sys.argv[2])
groups = sys.argv[3 : 3 + group_count]
packages = sys.argv[3 + group_count :]
state = {
    "version": 1,
    "selected_groups": sorted(set(groups)),
    "owned_packages": sorted(set(packages)),
}

directory = os.path.dirname(path)
os.makedirs(directory, mode=0o700, exist_ok=True)
temporary_path = None
try:
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=directory,
        prefix=".arch-packages.",
        suffix=".tmp",
        delete=False,
    ) as temporary_file:
        temporary_path = temporary_file.name
        json.dump(state, temporary_file, indent=2, sort_keys=True)
        temporary_file.write("\n")
        temporary_file.flush()
        os.fsync(temporary_file.fileno())
    os.chmod(temporary_path, 0o600)
    os.replace(temporary_path, path)
    temporary_path = None
finally:
    if temporary_path:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass
PY
}

is_protected_package() {
    case "$1" in
        base|base-devel|bash|filesystem|git|glibc|grub|networkmanager|pacman|python|sudo|systemd|linux|linux-*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

sort_array() {
    local array_name=$1
    local -n array_ref="$array_name"
    if (( ${#array_ref[@]} > 0 )); then
        mapfile -t array_ref < <(printf '%s\n' "${array_ref[@]}" | sort -u)
    fi
}

collect_unneeded_graphics_packages() {
    local files_name=$1
    local selected_groups_name=$2
    local installed_name=$3
    local desired_name=$4
    local result_name=$5
    local -n files_ref="$files_name"
    local -n selected_groups_ref="$selected_groups_name"
    local -n installed_ref="$installed_name"
    local -n desired_ref="$desired_name"
    local -n graphics_result_ref="$result_name"
    local -A selected_graphics_groups=()
    local file group line

    graphics_result_ref=()
    for group in "${selected_groups_ref[@]}"; do
        if is_graphics_package_group "$group"; then
            selected_graphics_groups["$group"]=1
        fi
    done
    if (( ${#selected_graphics_groups[@]} == 0 )); then
        return 0
    fi

    for file in "${files_ref[@]}"; do
        group=$(basename "$file" .txt)
        if ! is_graphics_package_group "$group" \
            || [[ -n "${selected_graphics_groups[$group]+x}" ]]; then
            continue
        fi

        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            if [[ -n "$line" && ! "$line" =~ ^# \
                && -n "${installed_ref[$line]+x}" \
                && -z "${desired_ref[$line]+x}" ]]; then
                graphics_result_ref+=("$line")
            fi
        done < "$file"
    done
    sort_array "$result_name"
}

collect_removal_candidates() {
    local installed_name=$1
    local desired_name=$2
    local owned_name=$3
    local result_name=$4
    local -n installed_ref="$installed_name"
    local -n desired_ref="$desired_name"
    local -n owned_ref="$owned_name"
    local -n result_ref="$result_name"

    result_ref=()
    local pkg
    for pkg in "${!owned_ref[@]}"; do
        if [[ -n "${installed_ref[$pkg]+x}" && -z "${desired_ref[$pkg]+x}" ]]; then
            if is_protected_package "$pkg"; then
                log_warn "Protected package remains managed and will not be removed: $pkg"
            else
                result_ref+=("$pkg")
            fi
        fi
    done
    sort_array "$result_name"
}

install_arch_packages() {
    if ! is_arch_or_cachyos; then
        return 0
    fi

    log_info "Detected Arch Linux or CachyOS system."

    if ! command -v pacman &> /dev/null; then
        log_error "pacman is required to install Arch Linux packages."
        return 1
    fi
    if [[ "$PACKAGE_ACTION" != "plan" ]] && ! command -v sudo &> /dev/null; then
        log_error "sudo is required to install packages."
        return 1
    fi
    if [[ ! -t 0 || ! -t 1 ]]; then
        log_warn "No interactive TTY available; skipping package installation."
        return 0
    fi
    local packages_dir="${BASEDIR}/dist/arch/packages"
    if [[ ! -d "$packages_dir" ]]; then
        log_warn "Packages directory not found at $packages_dir. Skipping package installation."
        return 0
    fi

    # Find all package files (*.txt)
    local files=()
    while IFS= read -r -d '' file; do
        files+=("$file")
    done < <(find "$packages_dir" -maxdepth 1 -name "*.txt" -print0 | sort -z)

    if (( ${#files[@]} == 0 )); then
        log_warn "No package files (*.txt) found in $packages_dir."
        return 0
    fi

    # Prepare display options
    local options=()
    for file in "${files[@]}"; do
        options+=("$(basename "$file" .txt)")
    done

    load_package_state
    PACKAGE_GROUP_DEFAULTS=()
    if [[ "$PACKAGE_STATE_LOADED" == true ]]; then
        local previous_group
        for previous_group in "${PREVIOUS_SELECTED_GROUPS[@]}"; do
            PACKAGE_GROUP_DEFAULTS["$previous_group"]=1
        done
    fi
    apply_standard_package_defaults
    apply_detected_graphics_defaults

    log_info "Select the package categories you would like to install."
    echo -e "Use ${BLUE}Up/Down Arrow${NC} keys to navigate, ${BLUE}Space${NC} to toggle, ${BLUE}Enter${NC} to confirm, ${BLUE}Escape${NC} to skip:\n" >&2

    # Set up exit trap for cursor restoration
    trap show_cursor EXIT

    local selected_idxs=()
    local selected_output
    selected_output=$(show_multi_select "${options[@]}")
    if [[ -n "$selected_output" ]]; then
        read -r -a selected_idxs <<< "$selected_output"
    fi

    if (( ${#selected_idxs[@]} == 0 )); then
        log_warn "No categories selected. Skipping package installation."
        return 0
    fi

    # Read packages from selected files.
    local all_pkgs=()
    local selected_groups=()
    for idx in "${selected_idxs[@]}"; do
        local file="${files[idx]}"
        local group_name
        group_name=$(basename "$file" .txt)
        selected_groups+=("$group_name")
        log_info "Reading packages from ${group_name}..."

        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            if [[ -n "$line" && ! "$line" =~ ^# ]]; then
                all_pkgs+=("$line")
            fi
        done < "$file"
    done

    if (( ${#all_pkgs[@]} == 0 )); then
        log_warn "No packages found in selected categories."
        return 0
    fi

    # Build the desired target set and snapshot the current package database.
    local desired_pkgs=()
    local -A desired_set=()
    local pkg
    for pkg in "${all_pkgs[@]}"; do
        if [[ -z "${desired_set[$pkg]+x}" ]]; then
            desired_set["$pkg"]=1
            desired_pkgs+=("$pkg")
        fi
    done
    sort_array desired_pkgs
    sort_array selected_groups

    local to_install=()
    local installed_count=0
    local -A installed_before=()
    while IFS= read -r pkg; do
        installed_before["$pkg"]=1
    done < <(pacman -Qq 2>/dev/null)

    for pkg in "${desired_pkgs[@]}"; do
        if [[ -n "${installed_before[$pkg]+x}" ]]; then
            installed_count=$((installed_count + 1))
        else
            to_install+=("$pkg")
        fi
    done

    local graphics_removal_candidates=()
    collect_unneeded_graphics_packages \
        files selected_groups installed_before desired_set graphics_removal_candidates

    log_info "Package status: ${installed_count} already installed, ${#to_install[@]} to install."

    # pacman only receives packages advertised by enabled official repositories.
    # Everything else is an AUR candidate and must be handled by an AUR helper.
    local repo_pkgs=()
    local aur_candidates=()
    local missing_multilib=()
    for pkg in "${to_install[@]}"; do
        if pacman -Si -- "$pkg" &> /dev/null; then
            repo_pkgs+=("$pkg")
        elif [[ "$pkg" == lib32-* || "$pkg" == "steam" ]]; then
            missing_multilib+=("$pkg")
        else
            aur_candidates+=("$pkg")
        fi
    done

    local removal_candidates=()
    local -A owned_set=()
    if [[ "$PACKAGE_STATE_LOADED" == true ]]; then
        for pkg in "${PREVIOUS_OWNED_PACKAGES[@]}"; do
            if [[ -n "${installed_before[$pkg]+x}" ]]; then
                owned_set["$pkg"]=1
            fi
        done
        collect_removal_candidates installed_before desired_set owned_set removal_candidates
    elif [[ "$PACKAGE_ACTION" == "reconcile" ]]; then
        log_warn "No valid ownership state exists; package removal is disabled for this run."
    fi

    if [[ "$PACKAGE_ACTION" == "plan" ]]; then
        log_info "Package plan (read-only):"
        if (( ${#repo_pkgs[@]} > 0 )); then
            printf '  Repository installs: %s\n' "${repo_pkgs[*]}"
        fi
        if (( ${#aur_candidates[@]} > 0 )); then
            printf '  AUR installs: %s\n' "${aur_candidates[*]}"
        fi
        if (( ${#missing_multilib[@]} > 0 )); then
            printf '  Blocked by missing [multilib]: %s\n' "${missing_multilib[*]}"
        fi
        if (( ${#removal_candidates[@]} > 0 )); then
            printf '  Managed removal candidates: %s\n' "${removal_candidates[*]}"
        elif [[ "$PACKAGE_STATE_LOADED" == true ]]; then
            printf '  Managed removal candidates: none\n'
        else
            printf '  Managed removal candidates: unavailable without valid state\n'
        fi
        if (( ${#graphics_removal_candidates[@]} > 0 )); then
            printf '  Obsolete graphics-driver removals: %s\n' \
                "${graphics_removal_candidates[*]}"
        else
            printf '  Obsolete graphics-driver removals: none\n'
        fi
        if (( ${#to_install[@]} == 0 )); then
            printf '  Installs: none\n'
        fi
        return 0
    fi

    if (( ${#missing_multilib[@]} > 0 )); then
        log_error "Packages require the multilib repository: ${missing_multilib[*]}"
        log_error "Enable [multilib] in /etc/pacman.conf, run sudo pacman -Syu, then rerun the installer."
        return 1
    fi

    local install_failed=false
    local needs_sudo=false
    if (( ${#repo_pkgs[@]} > 0 )); then
        needs_sudo=true
    fi
    if (( ${#graphics_removal_candidates[@]} > 0 )); then
        needs_sudo=true
    fi
    if [[ "$needs_sudo" == true ]] && ! sudo -v; then
        log_error "Unable to obtain sudo credentials."
        return 1
    fi

    if (( ${#repo_pkgs[@]} > 0 )); then
        log_info "Installing repository packages: ${repo_pkgs[*]}"
        if ! sudo pacman -Syu --needed -- "${repo_pkgs[@]}"; then
            log_error "Repository package installation failed."
            install_failed=true
        fi
    fi

    if [[ "$install_failed" == false && ${#aur_candidates[@]} -gt 0 ]]; then
        log_info "AUR candidates: ${aur_candidates[*]}"
        local AUR_HELPER=""
        local helper_status=0
        if ensure_aur_helper; then
            :
        else
            helper_status=$?
            if (( helper_status == 2 )); then
                log_warn "AUR packages were left uninstalled."
            else
                install_failed=true
            fi
        fi

        if [[ -n "$AUR_HELPER" ]]; then
            local aur_failures=()
            for pkg in "${aur_candidates[@]}"; do
                log_info "Installing AUR candidate with ${AUR_HELPER}: $pkg"
                if ! "$AUR_HELPER" -S --needed -- "$pkg"; then
                    log_error "Failed to install AUR candidate: $pkg"
                    aur_failures+=("$pkg")
                fi
            done
            if (( ${#aur_failures[@]} > 0 )); then
                log_error "AUR packages not installed: ${aur_failures[*]}"
                install_failed=true
            fi
        fi
    fi

    # Re-read authoritative package state after potentially partial transactions.
    local -A installed_after=()
    while IFS= read -r pkg; do
        installed_after["$pkg"]=1
    done < <(pacman -Qq 2>/dev/null)

    for pkg in "${!owned_set[@]}"; do
        if [[ -z "${installed_after[$pkg]+x}" ]]; then
            unset 'owned_set[$pkg]'
        fi
    done
    for pkg in "${desired_pkgs[@]}"; do
        if [[ -z "${installed_before[$pkg]+x}" && -n "${installed_after[$pkg]+x}" ]]; then
            owned_set["$pkg"]=1
        fi
    done

    # A package transaction may already have replaced a conflicting old driver.
    local remaining_graphics_removal_candidates=()
    for pkg in "${graphics_removal_candidates[@]}"; do
        if [[ -n "${installed_after[$pkg]+x}" ]]; then
            remaining_graphics_removal_candidates+=("$pkg")
        fi
    done
    graphics_removal_candidates=("${remaining_graphics_removal_candidates[@]}")

    local missing_desired=()
    for pkg in "${desired_pkgs[@]}"; do
        if [[ -z "${installed_after[$pkg]+x}" ]]; then
            missing_desired+=("$pkg")
        fi
    done
    sort_array missing_desired
    if (( ${#missing_desired[@]} > 0 )); then
        log_warn "Desired packages still missing; reconciliation is disabled: ${missing_desired[*]}"
    fi

    if [[ "$install_failed" == false \
        && ${#missing_desired[@]} -eq 0 \
        && ${#graphics_removal_candidates[@]} -gt 0 ]]; then
        local graphics_removal_preview=()
        local graphics_removal_output
        if graphics_removal_output=$(
            pacman -Rs --print --print-format '%n' -- "${graphics_removal_candidates[@]}"
        ); then
            if [[ -n "$graphics_removal_output" ]]; then
                mapfile -t graphics_removal_preview <<< "$graphics_removal_output"
                sort_array graphics_removal_preview
            else
                log_error "Pacman returned an empty graphics-driver removal transaction."
                install_failed=true
            fi
        else
            log_error "Pacman could not produce a safe graphics-driver removal transaction."
            install_failed=true
        fi

        local unsafe_graphics_removal=false
        local -A graphics_removal_preview_set=()
        for pkg in "${graphics_removal_preview[@]}"; do
            graphics_removal_preview_set["$pkg"]=1
            if [[ -n "${desired_set[$pkg]+x}" ]] || is_protected_package "$pkg"; then
                log_error "Unsafe package in graphics-driver removal transaction: $pkg"
                unsafe_graphics_removal=true
            fi
        done
        for pkg in "${graphics_removal_candidates[@]}"; do
            if [[ -z "${graphics_removal_preview_set[$pkg]+x}" ]]; then
                log_error "Graphics-driver removal preview omitted candidate: $pkg"
                unsafe_graphics_removal=true
            fi
        done

        if [[ "$install_failed" == false && "$unsafe_graphics_removal" == false ]]; then
            log_info "Removing obsolete graphics-driver packages: ${graphics_removal_candidates[*]}"
            if ! sudo pacman -Rs -- "${graphics_removal_candidates[@]}"; then
                log_error "Obsolete graphics-driver package removal failed or was cancelled."
                install_failed=true
            else
                installed_after=()
                while IFS= read -r pkg; do
                    installed_after["$pkg"]=1
                done < <(pacman -Qq 2>/dev/null)
            fi
        elif [[ "$unsafe_graphics_removal" == true ]]; then
            install_failed=true
        fi
    fi

    removal_candidates=()
    if [[ "$PACKAGE_STATE_LOADED" == true ]]; then
        collect_removal_candidates installed_after desired_set owned_set removal_candidates
    fi

    if [[ "$PACKAGE_ACTION" == "reconcile" \
        && "$install_failed" == false \
        && ${#missing_desired[@]} -eq 0 \
        && ${#removal_candidates[@]} -gt 0 ]]; then
        local removal_preview=()
        local removal_output
        if removal_output=$(
            pacman -Rs --print --print-format '%n' -- "${removal_candidates[@]}"
        ); then
            if [[ -n "$removal_output" ]]; then
                mapfile -t removal_preview <<< "$removal_output"
                sort_array removal_preview
            fi
        else
            log_warn "Pacman could not produce a safe removal transaction; nothing will be removed."
            removal_preview=()
        fi

        local unsafe_preview=false
        for pkg in "${removal_preview[@]}"; do
            if [[ -n "${desired_set[$pkg]+x}" ]] || is_protected_package "$pkg"; then
                log_error "Unsafe package in removal transaction: $pkg"
                unsafe_preview=true
            fi
        done

        if [[ "$unsafe_preview" == false && ${#removal_preview[@]} -gt 0 ]]; then
            printf '\nManaged packages no longer selected:\n'
            printf '  - %s\n' "${removal_candidates[@]}"
            printf 'Pacman removal transaction (including unneeded dependencies):\n'
            printf '  - %s\n' "${removal_preview[@]}"
            printf '\n[r] remove  [k] keep installed and stop managing  [c] cancel: '
            local removal_choice
            IFS= read -r removal_choice < /dev/tty
            case "$removal_choice" in
                r|R)
                    printf 'Type REMOVE to confirm: '
                    local confirmation
                    IFS= read -r confirmation < /dev/tty
                    if [[ "$confirmation" == "REMOVE" ]]; then
                        if ! sudo pacman -Rs -- "${removal_candidates[@]}"; then
                            log_error "Package removal failed or was cancelled."
                            install_failed=true
                        fi
                    else
                        log_warn "Removal confirmation did not match; nothing was removed."
                    fi
                    ;;
                k|K)
                    for pkg in "${removal_candidates[@]}"; do
                        unset 'owned_set[$pkg]'
                    done
                    log_info "Packages kept installed and released from dotfiles management."
                    ;;
                *)
                    log_info "Package removal cancelled; ownership was retained."
                    ;;
            esac
        fi
    fi

    # Only packages still present may remain owned after a removal attempt.
    local -A final_installed=()
    while IFS= read -r pkg; do
        final_installed["$pkg"]=1
    done < <(pacman -Qq 2>/dev/null)
    local owned_packages=()
    for pkg in "${!owned_set[@]}"; do
        if [[ -n "${final_installed[$pkg]+x}" ]]; then
            owned_packages+=("$pkg")
        fi
    done
    sort_array owned_packages
    write_package_state selected_groups owned_packages

    if [[ "$install_failed" == true ]]; then
        return 1
    fi
    if (( ${#to_install[@]} == 0 )); then
        log_success "All selected packages are already installed!"
    else
        log_success "Package installation completed successfully!"
    fi
}

apply_live_changes() {
    log_info "Applying system and desktop configuration changes..."

    # Rebuild font cache
    if command -v fc-cache &> /dev/null; then
        log_info "Rebuilding font cache..."
        fc-cache -f || log_warn "Failed to rebuild font cache"
    fi

    # Reload Mako notification daemon
    if command -v makoctl &> /dev/null && pgrep -x mako &> /dev/null; then
        log_info "Reloading Mako configuration..."
        makoctl reload || log_warn "Failed to reload Mako"
    fi

    # Reload Waybar
    if pgrep -x waybar &> /dev/null; then
        log_info "Reloading Waybar..."
        pkill -USR2 waybar || log_warn "Failed to signal Waybar to reload"
    fi
}

main() {
    parse_install_args "$@"
    if [[ "$SHOW_HELP" == true ]]; then
        show_help
        return 0
    fi
    log_info "Starting dotfiles installation..."

    check_dependencies
    install_arch_packages
    if [[ "$PACKAGE_ACTION" == "plan" ]]; then
        log_success "Package plan completed without changes."
        return 0
    fi
    backup_existing_files
    setup_dotbot

    run_dotbot "${DOTBOT_ARGS[@]}"
    install_vim_plugins
    apply_live_changes

    log_success "Dotfiles installation completed successfully!"
}

# Start the script
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
