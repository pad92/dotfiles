---
# Template for group_vars/all/vault.yml, which Git ignores. Create the real
# file encrypted, from the repository root:
#   ansible-vault create --vault-password-file .vault ansible/group_vars/all/vault.yml
# The values below are placeholders. Read the real descriptions with
#   hyprctl monitors all
# (the "description:" line); Hyprland matches them as "desc:<description>".
vault_dotfiles_monitor_outputs:
  dell: 'desc:Dell Inc. DELL P2423DE 0000000'
  asus: 'desc:ASUSTek COMPUTER INC XG32WCS EXAMPLE000000'
