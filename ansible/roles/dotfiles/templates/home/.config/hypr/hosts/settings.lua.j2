-- {{ ansible_managed }}
-- Host settings for Hyprland, loaded by include/host.lua. Edit the
-- dotfiles_hypr_* variables of the dotfiles role, not this file.
return {
  monitor_mode = {{ dotfiles_hypr_monitor_mode | dotfiles_to_lua(level=1) }},
  monitors = {{ dotfiles_hypr_monitors | dotfiles_to_lua(level=1) }},
  workspace_rules = {{ dotfiles_hypr_workspace_rules | dotfiles_to_lua(level=1) }},
  window_rules = {{ dotfiles_hypr_window_rules | dotfiles_to_lua(level=1) }},
  touch_monitor = {{ (dotfiles_hypr_touch_monitor or none) | dotfiles_to_lua(level=1) }},
  config = {{ dotfiles_hypr_config | dotfiles_to_lua(level=1) }},
}
