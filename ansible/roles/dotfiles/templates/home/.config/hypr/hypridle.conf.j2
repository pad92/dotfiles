# {{ ansible_managed }}

general {
    lock_cmd = ~/.bin/hyprlock-guard.sh hyprlock --no-fade-in -c ~/.config/hypr/hyprlock.conf
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
    inhibit_sleep = 3
}
listener {
    timeout = {{ dotfiles_hypridle_lock_timeout }}
    on-timeout = loginctl lock-session
}

listener {
    timeout = {{ dotfiles_hypridle_dpms_timeout }}
    on-timeout = ~/.bin/hyprlock-carousel-dpms.sh
    on-resume  = hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
}
{% if dotfiles_hypridle_suspend_timeout | int > 0 %}

# Suspend after inactivity (dotfiles_hypridle_suspend_timeout, in seconds).
listener {
    timeout = {{ dotfiles_hypridle_suspend_timeout }}
    on-timeout = ~/.bin/hyprlock-carousel-suspend.sh
    on-resume  = hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
}
{% endif %}
