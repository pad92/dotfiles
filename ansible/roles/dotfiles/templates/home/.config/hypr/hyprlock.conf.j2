

# Gruvbox Dark palette, kept manually in sync with waybar/style.css,
# .tmux.conf, gruvbox.nvim and .config/mako/config
$text_color = rgba(ebdbb2ff)
$text_dim_color = rgba(d5c4a1ff)
# Discreet field: nearly transparent, faint blue border, hidden while empty.
$entry_background_color = rgba(1d202111)
$entry_border_color = rgba(83a59855)
$entry_check_color = rgba(fabd2fff)
$entry_fail_color = rgba(fb4934ff)
$entry_color = rgba(ebdbb2ff)
$accent_secondary_color = rgba(b8bb26cc)
$accent_secondary_dim_color = rgba(b8bb2699)
$muted_text_color = rgba(928374cc)
$muted_text_opaque_color = rgba(928374ff)
$font_family = JetBrainsMono Nerd Font

general {

  hide_cursor = true
  ignore_empty_input = true
  text_trim = true
}

animations {
    enabled = false
}

background {
    path = {{ dotfiles_home }}/{{ dotfiles_hyprlock_wallpaper }}
    monitor =
    blur_size = 8
    blur_passes = 0 # 0 disables blurring
    noise = 0.0117
    contrast = 1.3000 # Vibrant!!!
    brightness = 0.8000
    vibrancy = 0.2100
    vibrancy_darkness = 0.0
}

# AUDIO VISUALIZER: faint Winamp-style spectrum (6 rows) over
# the bottom third, drawn first so the text and the music block stay on top
# of it. font_size must match FONT_SIZE_PT in hyprlock/visualizer.py, which
# sizes the bars to the widest monitor.
label {
    monitor =
    text = cmd[update:50] ~/.config/hypr/hyprlock/visualizer.sh
    color = $accent_secondary_color
    font_size = 48
    font_family = $font_family
    position = 0, 2
    halign = center
    valign = bottom
}

# INPUT FIELD
input-field {
    monitor =
    size = 300, 40
    outline_thickness = 2
    dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.2 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    outer_color = $entry_border_color
    inner_color = $entry_background_color
    font_color = $entry_color
    check_color = $entry_check_color
    fail_color = $entry_fail_color
    capslock_color = $entry_check_color
    fail_text = $FAIL ($ATTEMPTS)
    fade_on_empty = true
    placeholder_text =
    hide_input = true
    position = 0, 150
    halign = center
    valign = bottom
}

label { # Clock
    monitor =
    text = $TIME
    shadow_passes = 1
    shadow_boost = 0.5
    color = $text_color
    font_size = 80
    font_family = $font_family
    position = 0, -30
    halign = center
    valign = top
}

label { # Date
    monitor =
    text = cmd[update:60000] date +'%A %-d %B'
    shadow_passes = 1
    shadow_boost = 0.5
    color = $text_dim_color
    font_size = 20
    font_family = $font_family
    position = 0, -150
    halign = center
    valign = top
}

label { # Status
    monitor =
    text = cmd[update:10000] ~/.config/hypr/hyprlock/status.sh
    shadow_passes = 1
    shadow_boost = 0.5
    color = $text_color
    font_size = 14
    font_family = $font_family
    position = 30, -30
    halign = left
    valign = top
}

# Music
image {
    monitor =
    path = ~/.config/hypr/hyprlock/empty.png
    size = 150 # lesser side if not 1:1 ratio
    rounding = 5 # negative values mean circle
    border_size = 0
    rotate = 0 # degrees, counter-clockwise
    reload_time = 3
    reload_cmd = ~/.config/hypr/hyprlock/playerctlock.sh --arturl
    position = 10, 40
    halign = left
    valign = bottom
}

# PLAYER SOURCE
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/hyprlock/playerctlock.sh --source
    color = $accent_secondary_color
    font_size = 18
    font_family = JetBrainsMono Nerd Font Propo
    position = 10, 10
    halign = left
    valign = bottom
}

# PLAYER STATUS
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/hyprlock/playerctlock.sh --status
    color = $accent_secondary_dim_color
    font_size = 19
    font_family = JetBrainsMono Nerd Font Propo
    position = 170, 114
    halign = left
    valign = bottom
}

# PLAYER TITLE
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/hyprlock/playerctlock.sh --title
    color = $muted_text_color
    font_size = 15
    font_family = $font_family ExtraBold
    position = 170, 90
    halign = left
    valign = bottom
}

# PLAYER ALBUM
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/hyprlock/playerctlock.sh --album
    color = $muted_text_opaque_color
    font_size = 12
    font_family = $font_family
    position = 170, 70
    halign = left
    valign = bottom
}
# PLAYER Artist
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/hyprlock/playerctlock.sh --artist
    color = $muted_text_color
    font_size = 12
    font_family = $font_family ExtraBold
    position = 170, 50
    halign = left
    valign = bottom
}
