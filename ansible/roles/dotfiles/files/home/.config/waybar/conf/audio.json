{
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "tooltip-format": "{desc} : {volume} %\nclic : sortie suivante — clic droit : pavucontrol",
    "on-click": "~/.config/waybar/modules/cycle-default-sink",
    "on-click-right": "pavucontrol"
  },
  "custom/headsetcontrol": {
    "format": "{}",
    "exec": "~/.config/waybar/modules/headsetcontrol",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "interval": 3600
  }
}
