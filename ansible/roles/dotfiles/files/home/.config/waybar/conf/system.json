{
  "clock": {
    "locale": "fr_FR.UTF-8",
    "format": "{:L%a %d %b %Y  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip-format": "CPU : {usage} %\nfréquence moyenne : {avg_frequency} GHz\ncharge : {load}"
  },
  "memory": {
    "format": "{}% ",
    "tooltip-format": "Mémoire : {used:0.1f} / {total:0.1f} Gio ({percentage} %)\nswap : {swapUsed:0.1f} / {swapTotal:0.1f} Gio"
  },
  "custom/recording": {
    "exec": "$HOME/.bin/hypr-record.sh status",
    "on-click": "$HOME/.bin/hypr-record.sh stop",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/lact-profile": {
    "exec": "$HOME/.config/waybar/modules/lact-profile status",
    "on-click": "$HOME/.config/waybar/modules/lact-profile cycle",
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/vpn": {
    "exec": "$HOME/.config/waybar/modules/vpn status",
    "on-click": "$HOME/.config/waybar/modules/vpn toggle",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "hide-empty-text": true,
    "tooltip": true
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Batterie : {capacity} %",
    "tooltip-format-discharging": "Batterie : {capacity} %, {power:.1f} W\nautonomie : {time}",
    "tooltip-format-charging": "Batterie : {capacity} % (en charge)\npleine dans {time}",
    "tooltip-format-full": "Batterie : pleine"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip-format": "Luminosité : {percent} %"
  },
  "tray": {
    "spacing": 5
  }
}
