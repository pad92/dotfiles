{
  "clock": {
    "locale": "en_US.UTF-8",
    "format": "{:L%a %d %b %Y  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip-format": "CPU: {usage}%\naverage frequency: {avg_frequency} GHz\nload: {load}"
  },
  "memory": {
    "format": "{}% ",
    "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nswap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
  },
  "custom/recording": {
    "exec": "$HOME/.bin/hypr-record.sh status",
    "on-click": "$HOME/.bin/hypr-record.sh stop",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/lact-profile": {
    "exec": "$HOME/.config/waybar/modules/lact-profile status",
    "on-click": "$HOME/.config/waybar/modules/lact-profile cycle",
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true
  },
  "custom/vpn": {
    "exec": "$HOME/.config/waybar/modules/vpn status",
    "on-click": "$HOME/.config/waybar/modules/vpn toggle",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "hide-empty-text": true,
    "tooltip": true
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Battery: {capacity}%",
    "tooltip-format-discharging": "Battery: {capacity}%, {power:.1f} W\ntime left: {time}",
    "tooltip-format-charging": "Battery: {capacity}% (charging)\nfull in {time}",
    "tooltip-format-full": "Battery: full"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip-format": "Brightness: {percent}%"
  },
  "tray": {
    "spacing": 5
  }
}
