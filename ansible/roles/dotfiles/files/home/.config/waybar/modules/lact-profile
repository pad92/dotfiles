#!/usr/bin/env python3
"""Show LACT in Waybar, with power and scheduling services in its tooltip."""

import argparse
import html
import json
import subprocess
import sys

PROFILES = ("Balance", "Silence", "Jeux-perf")
PROFILE_DISPLAY = {
    "Balance": ("", "balance"),
    "Silence": ("Zzz", "silence"),
    "Jeux-perf": ("", "jeux-perf"),
}


def query(arguments: list[str]) -> str:
    return subprocess.run(
        arguments, capture_output=True, text=True, timeout=2, check=True
    ).stdout.strip()


def service_status(service: str) -> str:
    try:
        properties = dict(
            line.split("=", 1)
            for line in query(
                [
                    "systemctl",
                    "show",
                    f"{service}.service",
                    "--property=LoadState,ActiveState,SubState",
                ]
            ).splitlines()
            if "=" in line
        )
        if properties.get("LoadState") == "not-found":
            return f"{service} : non installé"
        active = properties.get("ActiveState", "unknown")
        substate = properties.get("SubState", "unknown")
        detail = f"{service} : {active} ({substate})"
        if service == "power-profiles-daemon" and active == "active":
            profile = query(["powerprofilesctl", "get"])
            if not profile:
                raise ValueError("profil d’énergie vide")
            detail += f"\nProfil d’énergie : {profile}"
        return detail
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        detail = (
            error.stderr.strip()
            if isinstance(error, subprocess.CalledProcessError) and error.stderr
            else str(error)
        )
        return f"{service} : lecture impossible\n{detail}"


def status() -> dict[str, str]:
    try:
        available = query(["lact", "cli", "profile", "list"]).splitlines()
        profile = query(["lact", "cli", "profile", "get"])
    except (OSError, subprocess.SubprocessError):
        return {"text": ""}
    text, css_class = PROFILE_DISPLAY.get(profile, ("?", "unknown"))
    tooltip = f"LACT : {profile or 'aucun'} — clic pour changer"
    if not set(PROFILES).issubset(available):
        text, css_class = "GPU profils?", "unavailable"
        tooltip += "\nProfils LACT requis : " + ", ".join(PROFILES)
    tooltip += "\n\n" + "\n".join(
        service_status(service) for service in ("power-profiles-daemon", "ananicy-cpp")
    )
    return {
        "text": html.escape(text),
        "tooltip": html.escape(tooltip),
        "class": css_class,
    }


def cycle_profile() -> None:
    available = query(["lact", "cli", "profile", "list"]).splitlines()
    if not set(PROFILES).issubset(available):
        raise ValueError("Profils LACT requis : " + ", ".join(PROFILES))
    current = query(["lact", "cli", "profile", "get"])
    index = (PROFILES.index(current) + 1) % len(PROFILES) if current in PROFILES else 0
    query(["lact", "cli", "profile", "set", PROFILES[index]])


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=["status", "cycle"], nargs="?", default="status"
    )
    if parser.parse_args().action == "status":
        print(json.dumps(status(), ensure_ascii=False))
    else:
        try:
            cycle_profile()
        except (OSError, subprocess.SubprocessError, ValueError) as error:
            print(f"LACT : {error}", file=sys.stderr)
            sys.exit(1)
