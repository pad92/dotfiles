#!/usr/bin/env python3
"""Show the SAML VPN in Waybar; a click connects or disconnects it.

Ansible writes the unit name and the login URL to CONFIG only when the VPN
gateway is in the Vault, so the module stays hidden on other hosts.
"""

import argparse
import html
import json
import subprocess
import sys
from pathlib import Path

CONFIG = Path("/etc/openfortivpn/waybar.json")
# Waybar refreshes the module on SIGRTMIN+<signal>, as set in system.json.
WAYBAR_SIGNAL = 9
STATES = {
    "active": ("connected", "VPN connecté — clic pour déconnecter"),
    "activating": (
        "connecting",
        "VPN : connexion SAML en attente dans le navigateur — clic pour annuler",
    ),
    "deactivating": ("connecting", "VPN : déconnexion en cours"),
    "failed": ("failed", "VPN : dernière connexion en échec — clic pour réessayer"),
}
DISCONNECTED = ("disconnected", "VPN déconnecté — clic pour se connecter")


def load_config() -> dict[str, str] | None:
    """Return the unit and login URL, or None when the VPN is not managed."""
    try:
        config = json.loads(CONFIG.read_text())
    except FileNotFoundError:
        return None
    if not (
        isinstance(config, dict)
        and isinstance(config.get("unit"), str)
        and config["unit"].endswith(".service")
        and isinstance(config.get("login_url"), str)
        and config["login_url"].startswith("https://")
    ):
        raise ValueError(f"{CONFIG} : unit ou login_url invalide")
    return config


def run(arguments: list[str]) -> str:
    return subprocess.run(
        arguments, capture_output=True, text=True, timeout=5, check=True
    ).stdout.strip()


def active_state(unit: str) -> str:
    return run(["systemctl", "show", unit, "--property=ActiveState", "--value"])


def status() -> dict[str, str]:
    try:
        config = load_config()
        if config is None:
            return {"text": ""}
        state = active_state(config["unit"])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        return {
            "text": "VPN ?",
            "tooltip": html.escape(f"VPN : lecture impossible\n{error}"),
            "class": "unknown",
        }
    css_class, tooltip = STATES.get(state, DISCONNECTED)
    return {"text": "VPN", "tooltip": html.escape(tooltip), "class": css_class}


def toggle() -> None:
    config = load_config()
    if config is None:
        raise ValueError(f"{CONFIG} absent : le VPN n'est pas configuré")
    unit = config["unit"]
    # --no-block: the unit is ready only after the browser login, which this
    # click starts; polkit grants start and stop without a password.
    state = active_state(unit)
    if state in ("active", "activating"):
        run(["systemctl", "stop", "--no-block", unit])
    elif state == "deactivating":
        # A start now would supersede the pending stop job and reconnect.
        pass
    else:
        run(["systemctl", "start", "--no-block", unit])
        subprocess.Popen(
            ["xdg-open", config["login_url"]],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"], check=False)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=["status", "toggle"], nargs="?", default="status"
    )
    if parser.parse_args().action == "status":
        print(json.dumps(status(), ensure_ascii=False))
    else:
        try:
            toggle()
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print(f"VPN : {error}", file=sys.stderr)
            sys.exit(1)
