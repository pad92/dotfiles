# Resolve DRM nodes at session startup; card numbers are not stable across boots.
if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/gpu-devices.sh" ]; then
    # shellcheck source=ansible/roles/dotfiles/files/home/.config/uwsm/gpu-devices.sh
    . "${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/gpu-devices.sh"
    if gpu_devices=$(hypr_gpu_devices); then
        export AQ_DRM_DEVICES="$gpu_devices"
    fi
    unset gpu_devices
    unset -f hypr_gpu_devices
fi
# Leave application driver selection automatic so prime-run can enable offload.
