# Managed by Ansible. The gateway comes from the Ansible Vault.
host = {{ vpn_gateway_host }}
port = {{ vpn_gateway_port }}
# The browser completes the SAML login and the MFA, then hands the session
# back to this local port. No password is stored.
saml-login = {{ vpn_saml_port }}
# DNS servers go to systemd-resolved on the ppp link through resolvconf;
# /etc/resolv.conf stays the resolved stub link.
set-dns = 1
use-resolvconf = 1
pppd-use-peerdns = 0
