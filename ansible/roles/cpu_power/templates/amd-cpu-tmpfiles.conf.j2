# Managed by Ansible. Reapply AMD CPU controls at boot.
# systemd-tmpfiles applies these lines in order: AMD P-State only accepts
# the EPP preference after the powersave governor is selected.
{% if cpu_power_amd_persist_epp | bool %}
w /sys/devices/system/cpu/cpufreq/policy*/scaling_governor - - - - powersave
w /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference - - - - {{ cpu_power_amd_pstate_epp }}
{% endif %}
{% if cpu_power_amd_persist_x3d | bool %}
w /sys/bus/platform/drivers/amd_x3d_vcache/*/amd_x3d_mode - - - - {{ cpu_power_amd_x3d_mode }}
{% endif %}
